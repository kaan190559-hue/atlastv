{
  "name": "localde-bir-uygulama-kuracag-z-sonra",
  "private": true,
  "version": "0.0.2",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "AtlasTv coklu platform istemcisi",
  "author": "AtlasTv",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "catalog:build": "node scripts/build-catalog-cache.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "node server.mjs",
    "electron:dev": "electron .",
    "electron:build": "node scripts/build-electron-win.mjs",
    "cap:add": "npx cap add android",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:tv:sync": "node scripts/sync-tv-project.mjs",
    "apk:phone": "node scripts/build-android-apk.mjs phone",
    "apk:tv": "node scripts/build-android-apk.mjs tv",
    "release:all": "npm run apk:phone && npm run apk:tv && npm run electron:build"
  },
  "build": {
    "appId": "com.atlastv.desktop",
    "productName": "AtlasTv",
    "icon": "build/icon.ico",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "AtlasTv-Setup-${version}.exe",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "installerLanguages": [
        "tr_TR",
        "en_US"
      ]
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "hls.js": "^1.6.16",
    "lucide-react": "^1.14.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.0",
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "libsodium-wrappers": "^0.8.4",
    "node-fetch": "^3.3.2",
    "png-to-ico": "^3.0.1",
    "puppeteer": "^24.42.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "tweetnacl": "^1.0.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10"
  }
}
